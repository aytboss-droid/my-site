# 비밀 정보 (인증키·비밀번호) — 절대 올리지 않음
.env
.env.*
!.env.example
*.key
*.pem
*secret*
*credentials*

# 로컬 도구·설정
.claude/
node_modules/
*.log

# 운영체제가 만드는 파일
Thumbs.db
desktop.ini
.DS_Store

# Vercel 연결 정보 (vercel 명령이 만듦)
.vercel/

.vercel
.env*
# 키 없는 견본은 올림 (위 .env* 규칙보다 뒤에 있어야 함)
!.env.example

# Python (Gemini 연결 코드)
__pycache__/
*.pyc
.venv/
venv/

# 다시 만들 수 있는 큰 자료 (tools/build-more.js, tools/build-photos.js가 만듦)
tools/kto-list.json
tools/cache/wiki-*.json
